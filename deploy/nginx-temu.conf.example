# nginx host untuk Temu (di belakang Cloudflare). Salin ke /etc/nginx/sites-available/temu,
# ganti server_name, lalu: ln -s … sites-enabled/ && nginx -t && systemctl reload nginx
server {
    listen 80;
    server_name temu.katili.dev;

    # foto untuk generate maksimal 8 MB, gambar hasil manual 12 MB
    client_max_body_size 14m;

    # saluran real-time aplikasi Mac (chat, WebSocket): butuh Upgrade + timeout panjang.
    # Server mengirim ping tiap 25 detik, jadi sambungan tidak dianggap diam.
    location = /api/app/ws {
        proxy_pass http://127.0.0.1:8093;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:8093;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
