# ============================================================================
# Temani — konfigurasi server (salin ke .env). Lihat DEPLOY.md.
# ============================================================================
APP_ENV=production
PUBLIC_URL=https://temani.katili.dev
APP_PORT=8093
# Di belakang nginx host + Cloudflare → percaya X-Forwarded-For / CF-Connecting-IP.
TRUST_PROXY=true

# Wajib di production (64 karakter hex). Buat dengan: openssl rand -hex 32
# Dipakai untuk mengenkripsi API key provider AI yang disimpan admin di database.
# Simpan salinannya TERPISAH dari backup database; kalau hilang, API key harus diisi ulang.
APP_SECRET=

DB_PASSWORD=ganti-password-db
# DB_HOST_PORT=          # kosong = port acak di 127.0.0.1

# Lama sesi pengguna (hari). Sesi admin selalu maksimal 12 jam.
SESSION_DAYS=30

# Koneksi ke provider AI (kenari.id, OpenRouter, …) TIDAK diatur di sini: admin mengelolanya
# di /admin/koneksi, dan API key-nya disimpan terenkripsi di database.
AI_TIMEOUT_SEC=180
# Provider palsu untuk demo/dev tanpa API key (JANGAN aktif di production).
AI_MOCK=false

# Tautan unduh aplikasi Mac yang ditampilkan di web.
MAC_DOWNLOAD_URL=https://github.com/kikiraihan/lite-mac-os-live-companion/releases/latest

# Akun admin tidak dibuat dari pendaftaran. Buat dengan:
#   make admin EMAIL=kamu@contoh.id PASSWORD='password-panjang'
# lalu masuk di /admin/login.
